# ─────────────────────────────────────────────────────────────────────────────
# Скопируй этот файл в .env (или задай переменные в Vercel → Settings → Env)
# и заполни своими значениями. Файл .env в git НЕ попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Бренд (подставляется в промпты, тексты и UI) ──────────────────────────────
BRAND_NAME="Acme"                       # название твоего продукта/бренда
BRAND_SITE="example.com"                # сайт продукта
BRAND_FOUNDER=""                        # имя основателя для постов от 1-го лица (можно пусто)
BRAND_ONE_LINER="что это за продукт одной фразой"

# ── Threads через Zernio ───────────────────────────────────────────────────────
# API key и Account ID берутся в кабинете Zernio; это разные значения.
ZERNIO_API_KEY="вставь_Zernio_API_key"
ZERNIO_ACCOUNT_ID="ID_подключённого_Threads_аккаунта"
THREADS_USERNAME="твой-хэндл-без-собаки"   # например acme.brand

# ── Telegram (бот для одобрения постов/ответов и алертов) ─────────────────────
TELEGRAM_BOT_TOKEN="токен_от_BotFather"
TELEGRAM_CHAT_ID="твой_личный_chat_id"     # куда слать карточки на одобрение
# Секрет для проверки подлинности апдейтов от Telegram. Можно оставить пустым
# (тогда webhook подключится без секрета), но лучше задать любую случайную строку.
TELEGRAM_WEBHOOK_SECRET=""

# ── LLM (генерация и переводы через OpenRouter) ───────────────────────────────
OPENROUTER_API_KEY="sk-or-..."

# ── GitHub (очередь постов хранится как .md прямо в репо) ──────────────────────
GITHUB_TOKEN="fine-grained_PAT_с_правами_Contents_RW_на_этот_репо"
GITHUB_REPO_OWNER="your-github-org"
GITHUB_REPO_NAME="threads-bot"
GITHUB_BRANCH="main"                       # ветка, куда бот коммитит очередь; обычно main

# ── Redis (состояние outreach/диалогов; например Upstash) ─────────────────────
# Если используешь Upstash REST:
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET="длинная_случайная_строка"       # одинаковое значение в Vercel и GitHub Actions

# ── Опционально ───────────────────────────────────────────────────────────────
# Публичный адрес твоего деплоя. На Vercel подставляется сам (VERCEL_URL).
# ОБЯЗАТЕЛЬНО задать вручную, если хостинг НЕ Vercel или если постишь с картинками —
# иначе бот не сможет отдать медиа в Threads.
PUBLIC_MEDIA_BASE_URL=""                   # например https://мой-бот.ru

# ── Безопасность публикаций ───────────────────────────────────────────────────
# Оставь 1 до отдельного подтверждения владельца после тестов.
THREADS_AUTOPOST_PAUSED="1"
# НЕ задавай ZERNIO_MIGRATION_COMPLETE до отдельного подтверждения владельца.
